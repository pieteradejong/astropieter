---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Default.astro';
import Card from '../components/Card.astro';
import Tag from '../components/Tag.astro';
import DemoBadge from '../components/DemoBadge.astro';

const allProjects = await getCollection('projects');

// Sort projects: first by order (if specified, lower numbers first), then by title
const projects = allProjects.sort((a, b) => {
	const orderA = a.data.order ?? 999;
	const orderB = b.data.order ?? 999;
	if (orderA !== orderB) {
		return orderA - orderB;
	}
	return a.data.title.localeCompare(b.data.title);
});

// A project "has a demo" only if it lists a demoUrl; test.sh --live fails on a
// dead one, so the badge can be trusted (DECISIONS.md #4, #5).
const demoCount = projects.filter((p) => p.data.demoUrl).length;
---

<Layout
	title="Projects"
	description="Software engineering and applied mathematics projects"
>
	<div class="content-container">
		<section class="projects-section">
			<h2>Current Projects</h2>
			<!-- Hidden until the script below runs, so without JS every card shows. -->
			<div class="demo-filter" role="group" aria-label="Filter projects" hidden>
				<button type="button" data-filter="all" aria-pressed="true">All ({projects.length})</button>
				<button type="button" data-filter="demo" aria-pressed="false">With live demo ({demoCount})</button>
			</div>
			<div class="grid-container">
				{projects.map((project) => (
					<div class="project-item" data-demo={project.data.demoUrl ? 'yes' : 'no'}>
					<Card 
						title={project.data.title}
						subtitle={project.data.description}
						className="project-card-content"
						showExpandButton={true}
					>
						<div class="project-content">
							{project.data.hero && (
								<a href={`/projects/${project.id}`} class="project-hero" tabindex="-1">
									<Image src={project.data.hero} alt={project.data.heroAlt ?? ''} widths={[480, 800, 1200]} sizes="(max-width: 800px) 100vw, 800px" />
								</a>
							)}
							<!-- Demo status and tech stack - always visible -->
							<div class="demo-status">
								<DemoBadge hasDemo={Boolean(project.data.demoUrl)} />
							</div>
							<div class="tech-stack">
								{project.data.techStack.map((tech) => (
									<Tag text={tech} />
								))}
							</div>

							<!-- Project links - always visible -->
							<div class="project-links">
								<a href={`/projects/${project.id}`} class="secondary-link">
									View Details →
								</a>
								{project.data.githubUrl && (
									<a href={project.data.githubUrl} class="secondary-link" target="_blank" rel="noopener noreferrer">
										Source Code →
									</a>
								)}
								{project.data.demoUrl && (
									<a href={project.data.demoUrl} class="secondary-link" target="_blank" rel="noopener noreferrer">
										Live Demo →
									</a>
								)}
							</div>

							<!-- Expandable details -->
							<div class="expandable-content">
								<div class="project-details">
									<h4>Key Features</h4>
									<ul>
										{project.data.keyFeatures.slice(0, 3).map((feature) => (
											<li>{feature}</li>
										))}
									</ul>

									<div class="project-tags">
										{project.data.tags.map((tag) => (
											<Tag text={tag} />
										))}
									</div>
								</div>
							</div>
						</div>
					</Card>
					</div>
				))}
			</div>
		</section>
	</div>
</Layout>

<script>
	// Demo filter (DECISIONS.md #5). State lives in ?demo=1 so a filtered view is linkable.
	const filter = document.querySelector<HTMLElement>('.demo-filter');
	const items = document.querySelectorAll<HTMLElement>('.project-item');
	if (filter) {
		const buttons = filter.querySelectorAll<HTMLButtonElement>('button[data-filter]');
		const apply = (demoOnly: boolean) => {
			items.forEach((item) => {
				item.hidden = demoOnly && item.dataset.demo !== 'yes';
			});
			buttons.forEach((b) => {
				b.setAttribute('aria-pressed', String((b.dataset.filter === 'demo') === demoOnly));
			});
		};
		buttons.forEach((b) => {
			b.addEventListener('click', () => {
				const demoOnly = b.dataset.filter === 'demo';
				apply(demoOnly);
				const url = new URL(location.href);
				if (demoOnly) url.searchParams.set('demo', '1');
				else url.searchParams.delete('demo');
				history.replaceState(null, '', url);
			});
		});
		apply(new URLSearchParams(location.search).get('demo') === '1');
		filter.hidden = false;
	}
</script>



<style>
	.projects-section {
		margin: 2rem 0;
	}

	.projects-section h2 {
		color: var(--non-link-text);
		font-size: 1.8rem;
		margin-bottom: 1.5rem;
	}

	.project-content {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.demo-filter {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}

	.demo-filter[hidden],
	.project-item[hidden] {
		display: none;
	}

	.demo-filter button {
		font: inherit;
		font-size: 0.95rem;
		padding: 0.35em 0.9em;
		background: var(--card-bg);
		color: var(--secondary-text);
		border: 1px solid var(--border);
		cursor: pointer;
	}

	.demo-filter button[aria-pressed='true'] {
		font-weight: 600;
		color: var(--accent);
		border-color: var(--accent);
	}

	.demo-filter button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.demo-status {
		margin-bottom: 0.75rem;
	}

	.project-hero {
		display: block;
		border: 1px solid var(--border);
		overflow: hidden;
	}

	.project-hero img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
	}

	.tech-stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}

	.project-details {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.project-details h4 {
		color: var(--non-link-text);
		font-size: 1.1rem;
		margin: 0 0 0.2rem 0; /* Decreased bottom margin for less space before bullets */
	}

	.project-details ul {
		margin: 0;
		padding-left: 1.5rem;
	}

	.project-details li {
		margin: 0.2rem 0;
		line-height: 1; /* Tighter line spacing for bullet points */
		color: var(--secondary-text);
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1rem 0;
	}

	.project-links {
		display: flex;
		gap: 1rem;
		margin-top: 1rem;
	}

	.project-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}

	/* Force single column for projects page */
	.grid-container {
		display: grid;
		grid-template-columns: 1fr !important;
		gap: var(--spacing-large);
		width: 100%;
	}

	/* Expandable content hidden by default */
	.expandable-content {
		display: none;
		animation: slideDown 0.2s ease-out;
	}

	/* Show expandable content when expanded */
	.project-content.expanded .expandable-content {
		display: block;
	}

	/* Rotate expand icon when expanded */
	.project-content.expanded .expand-icon {
		transform: rotate(180deg);
	}

	@keyframes slideDown {
		from {
			opacity: 0;
			max-height: 0;
		}
		to {
			opacity: 1;
			max-height: 1000px;
		}
	}
</style>
