---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// these go to meta tags
const { title = 'Default page title', description = 'Default page description' } = Astro.props;
---
<html lang="en" data-pub-theme="terracotta">
	<head>
		<BaseHead title={title} description={description} />
        <style>
			.title {
				margin: var(--spacing-unit) 0;
				padding: var(--spacing-unit) 0;
				text-align: center;
				line-height: 1.2;
			}
            .title h1 {
				margin: 0;
				font-size: var(--font-size-h1);
			}

			/* The one page container. --spacing-unit already scales with the
			   viewport, so no breakpoint overrides are needed here. */
			main.content-container {
				width: 100%;
				max-width: 720px;
				margin: var(--spacing-unit) auto;
				padding: 0 var(--spacing-unit);
				background: none;
				color: var(--primary-text);
				flex: 1 0 auto;
			}
		</style>
	</head>

	<body>
		<Header />
		<main class="content-container">
			<div class="title">
                <h1>{title}</h1>
            </div>
			<hr />
            <slot />
		</main>
		<Footer />
	</body>
</html>
