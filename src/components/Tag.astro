---
interface Props {
    text: string;
    variant?: 'default' | 'accent' | 'success' | 'warning';
    className?: string;
}

const { text, variant = 'default', className = '' } = Astro.props;

const variantClasses = {
    default: 'tag-default',
    accent: 'tag-accent',
    success: 'tag-success',
    warning: 'tag-warning'
};
---

<span class:list={['tag', variantClasses[variant], className]}>
    {text}
</span>

<style>
    .tag {
        display: inline-block;
        padding: 0.25em 0.75em;
        font-family: var(--pub-font-meta);
        font-size: 0.8rem; /* floor: 12px tags were the smallest text on the site */
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: var(--pub-track-label);
        line-height: 1.4;
        white-space: nowrap;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        box-sizing: border-box;
    }

    .tag-default {
        background: var(--pub-paper-2);
        color: var(--pub-muted);
        border: var(--pub-rule-hair) solid var(--pub-rule);
    }

    .tag-accent {
        background: var(--pub-paper-2);
        color: var(--pub-accent-deep);
        border: var(--pub-rule-hair) solid var(--pub-accent);
    }

    .tag-success {
        background: var(--pub-paper-2);
        color: var(--pub-accent-deep);
        border: var(--pub-rule-hair) solid var(--pub-accent-deep);
    }

    .tag-warning {
        background: var(--pub-paper-2);
        color: var(--pub-ink);
        border: var(--pub-rule-hair) solid var(--pub-rule);
    }

</style> 