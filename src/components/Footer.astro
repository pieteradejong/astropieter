---
// Cookie-less page-view analytics. Lives here, not in BaseHead: it renders a
// custom element, which would end <head> early and push the meta tags into <body>.
// Production only: in dev the component fetches a debug script from a Vercel
// CDN on every page, which records nothing and only adds a third-party request
// the browser tests then depend on.
import Analytics from '@vercel/analytics/astro';

const today = new Date();
---

{import.meta.env.PROD && <Analytics />}

<footer>
	<div class="content-container">
		<div class="footer-content">
			<div class="footer-section">
				<h3 class="section-header">Connect</h3>
				<div class="social-links">
					<a href="https://github.com/pieteradejong" target="_blank" rel="noopener noreferrer" class="accent-link">GitHub</a>
					<a href="https://linkedin.com/in/pieteradejong" target="_blank" rel="noopener noreferrer" class="accent-link">LinkedIn</a>
				</div>
			</div>
			<div class="footer-section">
				<h3 class="section-header">Quick Links</h3>
				<div class="quick-links">
					<a href="/blog" class="accent-link">Blog</a>
					<a href="/projects" class="accent-link">Projects</a>
					<a href="/reading" class="accent-link">Reading and Lyrics</a>
					<a href="/contact" class="button-link">Contact</a>
				</div>
			</div>
			<div class="footer-section">
				<h3 class="section-header">Interests</h3>
				<div class="interests">
					<span>Software Engineering</span>
					<span>Mathematics</span>
					<span>Skiing & Snowboarding</span>
					<span>Geopolitics</span>
					<span>Physical Fitness</span>
					<span>Spiritual Growth / Theology</span>
				</div>
			</div>
		</div>
		<div class="footer-bottom">
			<p>&copy; {today.getFullYear()} Pieter A. de Jong. All rights reserved.</p>
		</div>
	</div>
</footer>

<style>
	footer {
		background: var(--footer-bg);
		color: var(--secondary-text);
		padding: 2rem 0 1rem;
		border-top: 1px solid var(--border);
		width: 100%;
	}
	.content-container {
		max-width: var(--content-max-width, 900px);
		margin: 0 auto;
		padding-left: var(--spacing-unit);
		padding-right: var(--spacing-unit);
	}
	.footer-content {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 1.5rem;
		max-width: var(--content-max-width, 900px);
		margin: 0 auto;
		align-items: flex-start;
	}
	.footer-section {
		min-width: 0; /* the grid gap spaces the columns; no fixed column cap */
	}
	.footer-section h3.section-header {
		color: var(--non-link-text);
		font-size: 1.1rem;
		margin: 0 0 0.125rem;
		font-weight: 600;
	}
	.footer-section > div {
		display: flex;
		flex-direction: column;
	}
	/* Every footer link is a ≥44px tap target at every width. */
	.footer-section a:not(.button-link) {
		padding: 0.5rem 0;
		min-height: 44px;
		box-sizing: border-box;
		text-decoration: none;
		display: flex;
		align-items: center;
	}
	.footer-section a:not(.button-link):hover {
		text-decoration: underline;
	}
	.accent-link {
		color: var(--accent);
		text-decoration: none;
		transition: color 0.2s;
	}
	.accent-link:hover {
		color: var(--accent-hover);
		text-decoration: underline;
	}
	.footer-section .quick-links {
		display: flex;
		flex-direction: column;
	}
	.footer-section .quick-links a.button-link {
		margin-top: 0.25rem;
		padding: 0.5em 0.75em;
		min-height: 44px;
		display: inline-flex;
		align-items: center;
		text-align: center;
		width: fit-content;
	}
	.interests span {
		display: block;
		font-size: 0.95rem;
		color: var(--non-link-text);
		padding: 0.125rem 0;
	}
	.footer-bottom {
		margin: 1.5rem auto 0;
		padding: 1rem 0 0;
		border-top: 1px solid var(--border);
		text-align: center;
		font-size: 0.9rem;
		width: 100%;
	}
	.footer-bottom p {
		margin: 0;
	}
	@media (max-width: 767px) {
		.footer-content {
			grid-template-columns: 1fr 1fr;
			gap: 1rem;
		}
	}

	/* Mobile: Single column layout */
	@media (max-width: 480px) {
		.footer-content {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
		.footer-section {
			margin-bottom: 0.5rem;
		}
		.footer-section h3.section-header {
			font-size: 1.2rem;
			margin-bottom: 0.25rem;
		}
		.footer-section a:not(.button-link) {
			font-size: 1rem;
		}
		.interests span {
			font-size: 1rem;
			padding: 0.25rem 0;
		}
	}
</style>
