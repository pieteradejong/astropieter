---
import HeaderLink from './HeaderLink.astro';
import { Image } from 'astro:assets';
import profileImage from '../assets/pieter-de-jong-300.png';

// Get current page URL to determine which label to show
const currentPath = Astro.url.pathname;

let currentSection = 'Home'; // default
if (currentPath.startsWith('/blog')) {
	currentSection = 'Blog';
} else if (currentPath.startsWith('/about')) {
	currentSection = 'About';
} else if (currentPath.startsWith('/projects')) {
	currentSection = 'Projects';
} else if (currentPath.startsWith('/reading')) {
	currentSection = 'Reading';
} else if (currentPath.startsWith('/contact')) {
	currentSection = 'Contact';
}
---

<header>
	<div class="content-container">
		<nav>
			<div class="mobile-header-left">
				<a href="/" class="mobile-profile-link">
					<div class="mobile-profile">
						<Image 
							src={profileImage}
							alt="Pieter de Jong" 
							class="profile-image"
							width={40}
							height={40}
						/>
					</div>
				</a>
				<span class="mobile-profile-name">Pieter de Jong</span>
				<span class="mobile-section-label">{currentSection}</span>
			</div>
			<button class="nav-toggle" id="hamburgerBtn" aria-label="Open menu" aria-expanded="false" aria-controls="mainNav">
				<span class="hamburger-icon">☰</span>
			</button>
			<div class="nav-menu" id="mainNav">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
				<HeaderLink href="/projects">Projects</HeaderLink>
				<!-- <HeaderLink href="/software">Software</HeaderLink> -->
				<HeaderLink href="/reading">Reading and Lyrics</HeaderLink>
				<HeaderLink href="/contact">Contact</HeaderLink>
			</div>
		</nav>
	</div>
</header>

<script>
// Simple vanilla JS hamburger menu toggle
if (typeof window !== 'undefined') {
  window.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('hamburgerBtn');
    const nav = document.getElementById('mainNav');
    if (!btn || !nav) return;
    
    // Function to close the menu
    const closeMenu = (refocus = false) => {
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Open menu');
      nav.classList.remove('open');
      if (refocus) btn.focus();
    };
    const openMenu = () => {
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', 'Close menu');
      nav.classList.add('open');
      // Keyboard and screen-reader users land in the menu they just opened.
      nav.querySelector<HTMLAnchorElement>('a')?.focus();
    };
    
    // Toggle menu on button click
    btn.addEventListener('click', (e) => {
      e.stopPropagation(); // Prevent event bubbling
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      if (expanded) closeMenu(); else openMenu();
    });
    
    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      const isMenuOpen = nav.classList.contains('open');
      const target = e.target as Node;
      if (isMenuOpen && target && !nav.contains(target) && !btn.contains(target)) {
        closeMenu();
      }
    });
    
    // Close menu when a link is clicked (for SPA feel)
    nav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });
    
    // Close menu on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('open')) {
        closeMenu(true);
      }
    });
  });
}
</script>

<style>
/* The dropdown is positioned against the header, so it opens right under it
   whatever the header's height. */
header {
	position: relative;
	width: 100%;
}
/* The nav gets a wider column than the 720px prose measure, so six links fit
   on one row at desktop widths instead of wrapping Contact onto a second. */
header .content-container {
	max-width: 960px;
}

/* Mobile Header Layout */
.mobile-header-left {
	display: none;
	min-width: 0; /* lets the name truncate instead of pushing the button off-screen */
}

.mobile-profile-link {
	border-radius: 50%;
	display: inline-block;
	text-decoration: none;
	transition: transform 0.2s ease;
}

@media (hover: hover) {
	.mobile-profile-link:hover {
		transform: scale(1.05);
	}
}

.mobile-profile {
	display: inline-block;
}

.profile-image {
	width: 40px;
	height: 40px;
	border-radius: 50%;
	object-fit: cover;
	border: var(--pub-rule-hair) solid var(--pub-rule);
}

.mobile-profile-name {
	font-size: 1.1rem;
	font-weight: 600;
	color: var(--primary-text);
	display: none;
	min-width: 0;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}

.mobile-section-label {
	font-size: 1rem;
	font-weight: 600;
	color: var(--non-link-text);
	display: none;
	padding: 0.375rem 0.75rem;
	border: 1px solid var(--border);
	background-color: var(--footer-bg);
}

/* Mobile (< 768px): Hamburger menu */
@media (max-width: 767px) {
	.content-container nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 var(--spacing-unit);
	}

	.mobile-header-left {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.mobile-profile-name {
		display: inline-block;
	}

	.mobile-section-label {
		display: inline-block;
	}
}

/* Narrow phones (≤359px): avatar + name + hamburger only. */
@media (max-width: 359px) {
	.mobile-section-label {
		display: none;
	}
}

/* Mobile (< 768px): Hamburger menu */
.nav-toggle {
	display: block;
	background: none;
	border: none;
	font-size: 2rem;
	padding: 0.5em;
	min-width: 44px;
	min-height: 44px;
	cursor: pointer;
}
.nav-menu {
	display: none;
	flex-direction: column;
	align-items: stretch;
	gap: 0;
	position: absolute;
	top: 100%;
	left: 0;
	right: 0;
	background: var(--card-bg);
	border: var(--pub-rule-hair) solid var(--pub-rule);
	padding: 0.5rem 0;
	z-index: 1000;
}
/* Each dropdown item is a full-width, ≥44px tap target. */
.nav-menu a {
	display: flex;
	align-items: center;
	justify-content: center;
	min-height: 44px;
	padding: 0.5em 1em;
	width: 100%;
	box-sizing: border-box;
	font-size: 1rem;
}
.nav-menu.open {
	display: flex;
}

/* Tablet+ (≥ 768px): Horizontal nav */
@media (min-width: 768px) {
	.nav-toggle {
		display: none;
	}
	.nav-menu {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap; /* 768–900px: the long label wraps to a second row instead of overflowing */
		align-items: center;
		justify-content: center;
		position: static;
		background: none;
		border: none; /* the dropdown's box is a phone-only thing */
		box-shadow: none;
		padding: 0;
		gap: 0.25rem 0.5rem;
		width: 100%;
	}
	.nav-menu a {
		display: inline-block;
		width: auto;
		min-height: 0;
		padding: 0.15em 0.6em 0.25em;
		font-size: var(--pub-size-contents);
		white-space: nowrap; /* "Reading and Lyrics" never breaks inside */
	}
	.mobile-profile-name {
		display: none;
	}
}
/* Desktop (≥ 1024px): every link on one row, no wrapping. */
@media (min-width: 1024px) {
	.nav-menu {
		flex-wrap: nowrap;
		gap: 0.25rem 1rem;
	}
}
.hamburger-icon {
	display: block;
	line-height: 1;
}

/* Bottom border for nav links on hover/active */
.nav-menu a {
	border-bottom: 2px solid transparent;
	transition: border-color 0.2s;
	background: none;
	text-decoration: none;
}
.nav-menu a:hover,
.nav-menu a.active {
	border-bottom: 2px solid var(--accent);
	background: none;
	text-decoration: none;
}
.nav-menu a:active {
	background: none;
	color: var(--accent);
	border-bottom: 2px solid var(--accent);
}
/* Keyboard focus keeps the global outline (global.css nav a:focus-visible);
   pointer focus shows nothing extra. */
.nav-menu a:focus:not(:focus-visible) {
	outline: none;
}
</style>
