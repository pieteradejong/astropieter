---
// Who wrote a project's description: shown at the bottom of every project
// page, driven by the required `aiGenerated` field (DECISIONS #23).
interface Props {
	aiGenerated: boolean;
}

const { aiGenerated } = Astro.props;
---

<p class="authorship" data-ai-generated={String(aiGenerated)}>
	{aiGenerated ? (
		<>
			<svg class="ai-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="1.1em" height="1.1em">
				<path d="M10 3 L11.8 8.2 L17 10 L11.8 11.8 L10 17 L8.2 11.8 L3 10 L8.2 8.2 Z" fill="currentColor" />
				<path d="M18 14 L18.9 16.1 L21 17 L18.9 17.9 L18 20 L17.1 17.9 L15 17 L17.1 16.1 Z" fill="currentColor" />
			</svg>
			<span>Description generated by AI</span>
		</>
	) : (
		<span>Description written by Pieter</span>
	)}
</p>

<style>
	.authorship {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		margin: 2rem 0 0;
		padding-top: 1rem;
		border-top: 1px solid var(--border);
		color: var(--secondary-text);
		font-size: 0.875rem;
	}
	.ai-icon {
		flex: none;
		color: var(--accent);
	}
</style>
