---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/pub-core.css';
import '../styles/pub-fonts.css';
import '../styles/pub-theme-terracotta.css';
import '../styles/global.css';   // bridge + site rules; must come last
// KaTeX's stylesheet and fonts, bundled by Vite: no CDN request (DECISIONS #27).
// The direct katex pin must equal rehype-katex's katex; test.sh checks it.
import 'katex/dist/katex.min.css';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = '/blog-placeholder-1.jpg' } = Astro.props;

// Injected by astro.config.mjs (vite.define); see the build stamp note there.
const buildCommit = __BUILD_COMMIT__;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<meta name="build-commit" content={buildCommit} />

<!-- Font preloads: the two faces above the fold on every page -->
<link rel="preload" href="/fonts/source-serif-400.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/playfair-display-400.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/inter-600.woff2" as="font" type="font/woff2" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
